<?xml version="1.0" encoding="utf-8"?>
<window>
	<include>Animation_DialogPopupOpenClose</include>
	<controls>
		<control type="button">
			<description>background close area</description>
			<left>0</left>
			<top>0</top>
			<width>100%</width>
			<height>100%</height>
			<texturefocus />
			<texturenofocus />
			<onclick>Action(close)</onclick>
		</control>
		<control type="group">
			<centerleft>50%</centerleft>
			<bottom>210</bottom>
			<width>680</width>
			<height>470</height>
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>680</width>
				<height>470</height>
				<texture colordiffuse="CC000000">colors/white.png</texture>
			</control>
			<control type="image" id="10">
				<description>the preview thumbnail, set by the dialog</description>
				<left>20</left>
				<top>20</top>
				<width>640</width>
				<height>360</height>
				<aspectratio>keep</aspectratio>
				<texture></texture>
			</control>
			<control type="label">
				<left>20</left>
				<top>385</top>
				<width>640</width>
				<height>50</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font37</font>
				<textcolor>white</textcolor>
				<label>$INFO[Window.Property(scrubtime)]</label>
			</control>
			<control type="label">
				<left>20</left>
				<top>430</top>
				<width>640</width>
				<height>30</height>
				<align>center</align>
				<aligny>center</aligny>
				<font>font13</font>
				<textcolor>grey</textcolor>
				<label>$INFO[Window.Property(scrubdelta)]</label>
			</control>
		</control>
	</controls>
</window>
